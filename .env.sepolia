##########################################
### GIWA SEPOLIA TESTNET CONFIGURATION ###
##########################################


#====================#
# RETH CONFIGURATION #
#====================#

# CHAIN SPECIFIC
GENESIS_FILE=sepolia-genesis.json
RETH_ROLLUP_SEQUENCERHTTP=https://sepolia-sequencer.giwa.io
RETH_BOOTNODES=enode://60809a220201db7adad46b25166c9c5889f811cfd922faf1f9b534b1fa98a318513cc90461bbcd5ea02049df48bad2dde6f8f51662dd5a217bcb675464d7c3eb@52.79.47.75:30303,enode://557d0782a1c5935e1f1d94ca584f591508099393f3a3a65a05ba204a391bb755e8a5ff784d63ef20c9770f5a4d3c7ee4f507e7beec29d37d8fb4670126845ef4@43.202.26.64:30303,enode://ba49c97e2fd5f44fe4ae2cac956902c808399972d4429bba8fd96c1db64e3b5e95c9e48c451a7e2e5a583e31c595ab06f9f248a843ecfa068263b109177e215a@3.39.107.65:30303
# OPTIONAL - if you want to use the flashblocks feature, uncomment this line.
#FLASHBLOCKS_WEBSOCKET_URL=wss://sepolia-flashblocks.giwa.io/ws

# API
RETH_HTTP_PORT=8545
RETH_WS_PORT=8546
RETH_HTTP_API=eth,net,web3
RETH_WS_API=eth,net,web3
RETH_AUTHRPC_PORT=8551
RETH_AUTHRPC_JWTSECRET=/shared/jwtsecret.key

# COMMON
RETH_DATADIR=/app/data

# P2P
RETH_PORT=30303
RETH_DISCOVERY_PORT=30303
RETH_MAXPEERS=100

# METRICS
RETH_METRICS_PORT=6060

#====================#
# SYNC CONFIGURATION #
#====================#

# OPTION 1 - full node (prune ancient state, keep recent) + EL snap sync
RETH_GCMODE=full
OP_NODE_SYNCMODE=execution-layer

# OPTION 2 - archive node (retain full historical state)
#RETH_GCMODE=archive
#OP_NODE_SYNCMODE=execution-layer

# OPTION 3 - consensus driven sync (op-node drives reth via engine API)
#RETH_GCMODE=full
#OP_NODE_SYNCMODE=consensus-layer


#====================#
# NODE CONFIGURATION #
#====================#

# CHAIN SPECIFIC
OP_NODE_ROLLUP_CONFIG=sepolia-rollup.json
OP_NODE_L1_ETH_RPC=<your-preferred-l1-eth-rpc>
OP_NODE_L1_RPC_KIND=debug_geth
